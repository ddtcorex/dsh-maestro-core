[Unit]
Description=DSH Web Supervisor — auto-rollback for dsh web crashes
After=network.target dsh-web.service
Wants=dsh-web.service

[Service]
Type=simple
# Portable: sources nvm directly (bash -lc alone fails — ~/.bashrc guard),
# then execs node (works for nvm, fnm, volta, system via PATH fallback)
ExecStart=/bin/bash -c 'export NVM_DIR="$HOME/.nvm"; [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"; exec node %MAESTRO_ROOT%/packages/dsh-maestro-core/lib/bin.js daemon'
Restart=always
RestartSec=2
Environment=DSH_HOME=%h/.dsh
# The daemon's nohup fallback and debug-agent dry-boot launch dsh through DSH_BIN.
Environment=DSH_BIN=%h/.local/share/dsh/current/bin/dsh
# Optional Telegram — loose mode: set these if you want Telegram alerts, otherwise daemon logs only
# Environment=TELEGRAM_BOT_TOKEN=your_bot_token
# Environment=TELEGRAM_CHAT_ID=your_chat_id
# For hard dependency (workspace:^), ensure notifier is installed: pnpm add @ddtcorex/dsh-maestro-notifier

[Install]
WantedBy=default.target
