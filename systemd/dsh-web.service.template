[Unit]
Description=DSH Web — main harness web UI + webhook (:3080/:3000)
After=network.target
Wants=network.target
# Cap boot crash loops: if the unit fails to start more than 3 times within 60s,
# systemd stops retrying until the interval elapses (avoids a tight restart storm).
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%MAESTRO_ROOT%/deepseek-harness
# Portable: sources nvm directly (bash -lc alone fails — ~/.bashrc exits early for
# non-interactive shells via `case $- in *i*) ;; *) return;; esac`, so nvm never loads).
# Falls back to system node for machines without nvm — no hardcoded /v24.19.0 version.
ExecStart=/bin/bash -c 'export NVM_DIR="$HOME/.nvm"; [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"; exec node --import tsx/esm apps/cli/src/bin.ts web --no-open'
Restart=always
RestartSec=5
# Wait (up to 30 x 5s) for the previous instance to release the raw webserver
# port before starting, so a restart never races its predecessor into EADDRINUSE.
# Fails the start (exit 1) if the port is still held after the wait.
ExecStartPre=/bin/bash -c "for i in {1..30}; do ss -tln 2>/dev/null | grep -q 127.0.0.1:3082 || exit 0; sleep 5; done; exit 1"
Environment=DSH_HOME=%h/.dsh
Environment=NODE_ENV=production
# Log to file for supervisor health tail (append keeps history across restarts)
StandardOutput=append:%h/.dsh/dsh-web.log
StandardError=append:%h/.dsh/dsh-web.log

[Install]
WantedBy=default.target
